# schwab_trader configuration template.
# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit it. Defaults shown are the built-ins;
# leave a line commented out to keep the default.

# ---- Schwab API credentials (developer.schwab.com) ----
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
# Must EXACTLY match the callback URL registered on your Schwab app.
#SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
#SCHWAB_TOKEN_PATH=./schwab_token.json
# Which linked account to trade (0 = first account returned by the API).
#SCHWAB_ACCOUNT_INDEX=0

# ---- Safety / mode ----
# DRY_RUN=true validates orders via preview_order and NEVER places them.
#DRY_RUN=true
# Real-money trading additionally requires this exact phrase:
#LIVE_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
#KILL_SWITCH_FILE=./KILL_SWITCH
# Daily equity baseline (JSON fallback when the DB is disabled).
#DAILY_STATE_FILE=./daily_state.json

# ---- Persistence (SQLite). Empty disables the DB (JSON fallbacks used). ----
#SCHWAB_DB_PATH=./schwab_trader.db

# ---- Universe & strategy ----
#SYMBOLS=AAPL,MSFT
#POLL_INTERVAL_SECONDS=60
#SMA_FAST=20
#SMA_SLOW=50

# ---- Position sizing & bracket exits ----
#POSITION_SIZE_USD=1000
#TAKE_PROFIT_PCT=0.05
#STOP_LOSS_PCT=0.03

# ---- Hard risk limits ----
#MAX_POSITION_USD=2500
#MAX_SHARES_PER_SYMBOL=1000
#MAX_TOTAL_EXPOSURE_USD=10000
#MAX_OPEN_POSITIONS=5
#MAX_DAILY_LOSS_USD=500
#MAX_PRICE_DEVIATION_PCT=0.02
#PER_SYMBOL_COOLDOWN_SECONDS=300
# Entries per symbol per ET day (a stop-out's signal stays true all day).
#MAX_ENTRIES_PER_SYMBOL_PER_DAY=2

# ---- Notifications (optional; see notify.py) ----
# Signal messenger webhook for INFORMATIONAL events, e.g. signal-cli-rest-api:
#SIGNAL_WEBHOOK_URL=http://localhost:8080/v2/send
#SIGNAL_NUMBER=+15551234567
#SIGNAL_RECIPIENTS=+15557654321
# Pushover for URGENT events (halts, kill switch, unprotected positions):
#PUSHOVER_TOKEN=
#PUSHOVER_USER=
#PUSHOVER_PRIORITY=1
#NOTIFY_COOLDOWN_SECONDS=300

# ---- Logging ----
#LOG_LEVEL=INFO
#LOG_FILE=./schwab_bot.log

# ---- Signal feeds (read by the CLIs, not by Config) ----
# SEC requires a contact User-Agent for the EDGAR insider feed:
#EDGAR_USER_AGENT=MyBot/1.0 (you@example.com)
# Optional UA override for the congressional feed:
#CONGRESS_USER_AGENT=schwab-trader-congress/1.0 (personal research bot)
